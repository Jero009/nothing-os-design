{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Nothing OS design — measured spec",
    "version": "1.4.2",
    "updated": "2026-11-28",
    "source": "https://github.com/Jero009/nothing-os-design",
    "license": "MIT",
    "labels": {
      "official": "from Nothing's own materials",
      "impl": "working implementation value (dashbord / Essential Island / MissingCore — see docs/third-party-case-studies.md)"
    }
  },
  "brand": {
    "black": { "value": "#000000", "label": "official" },
    "white": { "value": "#FFFFFF", "label": "official" },
    "windowGrey": { "value": "#B1B3B3", "label": "official", "usage": "secondary text, dividers" },
    "nGrey": { "value": "#DCD7D2", "label": "official" },
    "lightSection": { "value": "#F4F4F4", "label": "official" },
    "red": {
      "print": { "value": "#C8102E", "label": "official", "usage": "print brand red; never on-screen in Nothing system UI" },
      "onScreen": { "value": "#D71921", "label": "official", "note": "device-measured EXACT; nothing.wiki cites #D71920 — one bit, same family", "usage": "THE signal accent (0–2 elements per screen)" },
      "blue": { "value": "#002F6C", "label": "official", "usage": "data encoding only" },
      "yellow": { "value": "#FFC700", "label": "official", "usage": "data encoding only" }
    }
  },
  "dark": {
    "bg": { "value": "#000000", "label": "impl", "usage": "true OLED black, never near-black" },
    "surface": { "value": "#1A1A1A", "label": "impl", "note": "system measures #1B1B1B — same family" },
    "surface2": { "value": "#242424", "label": "impl", "usage": "elevated/pressed" },
    "tile": { "value": "rgba(255,255,255,0.055)", "label": "impl", "usage": "inset panel" },
    "border": { "value": "rgba(255,255,255,0.08)", "borderStrong": "rgba(255,255,255,0.12)", "label": "impl" },
    "text": { "value": "#FFFFFF", "label": "impl" },
    "textDim": { "value": "rgba(255,255,255,0.5)", "label": "impl" },
    "textGlow": { "value": "rgba(255,255,255,0.18)", "label": "impl", "usage": "decoration only" },
    "accent": { "value": "#D71A21", "label": "impl", "note": "canonical #D71921; press = #B21319 (accent darkens ~10–15%, never lightens)", "onAccent": "#FFFFFF" },
    "dataPositive": { "value": "rgb(34,197,94)", "label": "impl" },
    "dataGoal": { "value": "#FFD700", "label": "impl" }
  },
  "light": {
    "bg": { "value": "#EBEBEB", "label": "impl" },
    "surface": { "value": "#FFFFFF", "label": "impl" },
    "surface2": { "value": "#E2E2E2", "label": "impl" },
    "border": { "value": "rgba(0,0,0,0.08)", "borderStrong": "rgba(0,0,0,0.14)", "label": "impl" },
    "text": { "value": "#0A0A0A", "label": "impl" },
    "textDim": { "value": "rgba(0,0,0,0.5)", "label": "impl" },
    "dataPositive": { "value": "rgb(21,128,61)", "label": "impl" },
    "dataGoal": { "value": "#B8860B", "label": "impl" }
  },
  "os5": {
    "dark": {
      "surface": { "value": "rgba(20,20,20,0.66)", "label": "impl", "usage": "+ frost backdrop-filter" },
      "surface2": { "value": "rgba(44,44,44,0.72)", "label": "impl" },
      "surfaceFallback": { "value": "#141414", "label": "impl", "usage": "solid overlays — never frost over a dimmed backdrop" },
      "frost": { "value": "blur(24px) saturate(1.4)", "label": "impl" },
      "border": { "value": "rgba(255,255,255,0.10)", "borderStrong": "rgba(255,255,255,0.16)", "label": "impl" },
      "textDim": { "value": "rgba(255,255,255,0.55)", "label": "impl" },
      "dotGrid": { "value": "rgba(255,255,255,0.045)", "label": "impl" }
    },
    "light": {
      "surface": { "value": "rgba(255,255,255,0.72)", "label": "impl" },
      "surface2": { "value": "rgba(255,255,255,0.9)", "label": "impl" },
      "surfaceFallback": { "value": "#FFFFFF", "label": "impl" },
      "border": { "value": "rgba(0,0,0,0.08)", "borderStrong": "rgba(0,0,0,0.14)", "label": "impl" },
      "textDim": { "value": "rgba(0,0,0,0.5)", "label": "impl" },
      "dotGrid": { "value": "rgba(0,0,0,0.05)", "label": "impl" }
    },
    "widgetPanel": { "value": "#D9141414", "radius": "28dp", "hairline": "#1FFFFFFF", "format": "Android ARGB (alpha first) — in CSS write rgba: panel rgba(19,19,19,0.08), hairline rgba(255,255,255,0.12)", "label": "impl", "usage": "native RemoteViews — can't frost" }
  },
  "typography": {
    "classic": { "body": "Space Grotesk", "numerics": "Doto", "mono": "Space Mono", "label": "impl (OFL stand-ins)" },
    "os5": { "body": "Geist", "numerics": "Geist Mono", "heroDisplay": "Doto — hero only", "label": "official faces; OFL stand-ins recommended" },
    "tracking": { "label": "0.10em (OS 5) / 0.12em (classic)", "kicker": "0.16em (OS 5) / 0.18em (classic)", "label": "impl" },
    "dotoWeightRule": "dot-matrix display ≈400–500 weight — heavy weights smear dots",
    "numeralsRule": "numerals never render in the body face"
  },
  "radii": {
    "classic": { "sm": "8px", "md": "16px", "lg": "24px", "pill": "999px", "label": "impl" },
    "os5": { "sm": "12px", "md": "20px", "lg": "28px", "pill": "999px", "label": "impl", "note": "measured OS cards ≈25px @720 ≈ 12–13dp — the OS number is smaller than the impl scale" }
  },
  "spacing": { "scale": ["4px", "8px", "12px", "16px", "24px", "32px"], "label": "impl" },
  "motion": {
    "durations": { "micro": "140ms", "standard": "280ms", "emphatic": "400ms", "label": "impl" },
    "easing": { "entrance": "cubic-bezier(0.2, 0, 0, 1)", "standard": "cubic-bezier(0.4, 0, 0.2, 1)", "label": "impl" },
    "pressScale": 0.97,
    "reducedMotion": "handle prefers-reduced-motion globally; durations ≈0, iterations 1"
  },
  "accentRules": {
    "budget": "0–2 accent elements per screen; ≤1 hero signal region per screenful",
    "signalRedGets": ["destructive confirm", "live/recording pulse", "error/warning threshold", "needs-decision badge"],
    "neverGetsAccent": ["navigation chrome", "toolbars", "backgrounds", "body text", "titles", "dividers", "whole cards", "empty states"],
    "alpha": "derive via color-mix(in srgb, var(--accent) N%, transparent) — never a new hex",
    "onAccentText": "flips white/black by contrast",
    "danger": "stays red even when the expression accent is another hue"
  }
}
